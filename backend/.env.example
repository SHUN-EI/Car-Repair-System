# 数据库配置
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=maintenance_db
DB_HOST=localhost
DB_PORT=15432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=7379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# 向量检索已迁到 PostgreSQL pgvector，不再需要独立 Milvus / MinIO。
# 维度必须与本地推理服务中的 bge-m3 一致。
VECTOR_DIM=1024
# 兼容旧名，可省略（与 VECTOR_DIM 同值）
# MILVUS_VECTOR_SIZE=1024
PGVECTOR_EF_SEARCH=64
# ts_rank 权重 {D,C,B,A}；标题与故障码为 A，正文为 B，标签为 C
# TS_RANK_WEIGHTS={0.1, 0.2, 0.4, 1.0}

# 对话模型切换（重要！）
# cloud：阿里云百炼（通义千问）OpenAI 兼容接口
# local：本机 vLLM 的 Qwen2.5-7B-Instruct（端口不要占用 embedding 的 8010）
# 兼容：CHAT_LLM_MODE=deepseek 时仍可读下面旧的 DEEPSEEK_* 变量
CHAT_LLM_MODE=cloud

CHAT_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_CLOUD_MODEL=qwen-plus
CHAT_CLOUD_API_KEY=sk-your-dashscope-api-key
# DASHSCOPE_API_KEY=  # 可选；CHAT_CLOUD_API_KEY 为空时回退用它

# 本地模式示例（先在推理机启动）：
# vllm serve Qwen/Qwen2.5-7B-Instruct --host 0.0.0.0 --port 8001 --served-model-name Qwen/Qwen2.5-7B-Instruct
CHAT_LOCAL_BASE_URL=http://127.0.0.1:8001/v1
CHAT_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
CHAT_LOCAL_API_KEY=dummy

# 钉钉开放平台配置（在钉钉开放平台创建企业内部应用后获得）
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_AGENT_ID=your-dingtalk-agent-id
DINGTALK_CORP_ID=your-dingtalk-corp-id
# 企业内部机器人 RobotCode（单聊消息用）
DINGTALK_ROBOT_CODE=your-dingtalk-robot-code
# OAuth2 授权回调地址（需与钉钉后台"登录与分享"配置一致，可用 cpolar 内网穿透域名）
DINGTALK_REDIRECT_URI=https://your-domain/api/v1/dingtalk/callback
DINGTALK_MOCK_MODE=false
# Stream 模式开关：true 用长连接接收事件（推荐，无需公网回调地址）；false 走 HTTP 回调
DINGTALK_STREAM_MODE=true
# 请假 OA 审批模板 processCode（从钉钉后台 OA 模板"查看编码"复制）
DINGTALK_LEAVE_PROCESS_CODE=PROC-your-process-code

# 追踪后端配置（支持 ragflow / langfuse / local）
TRACING_BACKEND=local
RAGFLOW_HOST=http://localhost:9380
RAGFLOW_API_KEY=ragflow-your-api-key
RAGFLOW_TRACES_DATASET=ticket_traces
RAGFLOW_ENABLED=False
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=False

# 应用配置
APP_NAME=Smart-Repair-System
APP_VERSION=1.0.0
DEBUG=True
BACKEND_PORT=18080

# JWT 配置
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 阿里云短信。验证码和车主状态通知分开，避免状态短信占用验证码模板。
# SMS_ENABLED=false 时车主通知只打印到后端日志，不请求阿里云。
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_NOTICE_TEMPLATE_CODE=
SMS_ENABLED=false

# 调度与设备同步。不要把真实密钥提交进仓库。未配置时对应接口拒绝调用。
SCHEDULER_TOKEN=
DEVICE_SYNC_API_KEY=
DEVICE_SYNC_HMAC_SECRET=
DINGTALK_INTERNAL_TOKEN=

# 非调试时的浏览器来源，逗号分隔。DEBUG=true 时仍允许任意来源。
CORS_ORIGINS=

# 第三方只读 MCP 默认关闭。需要时再设为 true，并配置 MCP_API_KEY。
MCP_PUBLIC_ENABLED=false
MCP_API_KEY=